local function bindDropdown(selectedTheme)
    G_State.CurrentTheme = selectedTheme
    CurrentTheme = Themes[selectedTheme] or Themes.Default
    for category, elements in pairs(ThemeTracker) do
        local color = CurrentTheme[category]
        for _, item in ipairs(elements) do
            if item.Object and item.Object.Parent then
                TweenService:Create(item.Object, TweenInfo.new(0.2, Enum.EasingStyle.Quad), {[item.Property] = color}):Play()
            end
        end
    end
end

