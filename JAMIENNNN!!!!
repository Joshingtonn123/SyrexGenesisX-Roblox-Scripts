local function executeUIRegistrySearch(query)
    query = string.lower(query)
    
    if query == "" then
        for _, tabBtn in ipairs(tabs) do tabBtn.Visible = true end
        for _, node in ipairs(SearchRegistry) do 
            node.UiInstance.Visible = true 
            if node.SectionFrame then node.SectionFrame.Visible = true end
        end
        if currentActivePage then currentActivePage.Visible = true end
        return
    end

    local preferredMatchPage = nil
    local preferredMatchTabBtn = nil

    -- Hide everything temporarily for filtering
    for _, node in ipairs(SearchRegistry) do
        if node.SectionFrame then node.SectionFrame.Visible = false end
    end

    for _, node in ipairs(SearchRegistry) do
        local matches = string.find(string.lower(node.FeatureName), query) ~= nil
        node.UiInstance.Visible = matches
        
        if matches then
            if node.SectionFrame then 
                node.SectionFrame.Visible = true
                node.UiInstance.Parent.Visible = true -- Expand section contents
            end
            if not preferredMatchPage then
                preferredMatchPage = node.ParentPage
                preferredMatchTabBtn = node.TabButton
            end
        end
    end

    if preferredMatchPage and preferredMatchTabBtn then
        for _, page in pairs(pages) do page.Visible = false end
        for _, tBtn in pairs(tabs) do 
            tBtn.TextColor3 = Color3.fromRGB(140, 140, 150) 
            applyThemeElement(tBtn, "BackgroundColor3", "Background")
        end
        preferredMatchPage.Visible = true
        currentActivePage = preferredMatchPage
        preferredMatchTabBtn.TextColor3 = Color3.fromRGB(245, 245, 250)
        applyThemeElement(preferredMatchTabBtn, "BackgroundColor3", "Accent")
    end
end
SearchBox:GetPropertyChangedSignal("Text"):Connect(function() executeUIRegistrySearch(SearchBox.Text) end)

