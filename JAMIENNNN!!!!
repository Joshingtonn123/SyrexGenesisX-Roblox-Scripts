local CurrentTheme = Themes[G_State.CurrentTheme] or Themes.Default
local ThemeTracker = { Background = {}, Secondary = {}, Accent = {}, AccentGlow = {} }

local function applyThemeElement(obj, property, category)
    table.insert(ThemeTracker[category], {Object = obj, Property = property})
    obj[property] = CurrentTheme[category]
end

local function applyCorner(obj, radius)
    local corner = Instance.new("UICorner")
    corner.CornerRadius = UDim.new(0, radius or 6) 
    corner.Parent = obj
end

