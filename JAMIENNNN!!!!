local function createTabCategory(name)
    local categoryBtn = Instance.new("TextButton")
    categoryBtn.Size = UDim2.new(1, -12, 0, 26)
    categoryBtn.Text = "  " .. name
    categoryBtn.TextColor3 = Color3.fromRGB(180, 180, 190)
    categoryBtn.Font = Enum.Font.GothamBlack
    categoryBtn.TextSize = 11
    categoryBtn.TextXAlignment = Enum.TextXAlignment.Left
    categoryBtn.BackgroundTransparency = 1
    categoryBtn.Parent = TabScrollContainer
    
    local arrow = Instance.new("TextLabel")
    arrow.Size = UDim2.new(0, 20, 1, 0)
    arrow.Position = UDim2.new(1, -20, 0, 0)
    arrow.BackgroundTransparency = 1
    arrow.Text = "▼"
    arrow.TextColor3 = Color3.fromRGB(140, 140, 150)
    arrow.Font = Enum.Font.GothamBold
    arrow.TextSize = 10
    arrow.Parent = categoryBtn

    local childTabs = {}
    local expanded = true

    categoryBtn.MouseButton1Click:Connect(function()
        expanded = not expanded
        arrow.Text = expanded and "▼" or "▶"
        for _, tab in ipairs(childTabs) do tab.Visible = expanded end
    end)

    return {
        AddTab = function(self, tabName)
            local page = Instance.new("ScrollingFrame")
            page.Name = tabName
            page.Size = UDim2.new(1, 0, 1, 0)
            page.BackgroundTransparency = 1
            page.BorderSizePixel = 0
            page.ScrollBarThickness = 2
            page.Visible = false
            page.Parent = ContentContainer
            page.CanvasSize = UDim2.new(0, 0, 0, 0)
            applyThemeElement(page, "ScrollBarImageColor3", "Accent")
            
            local list = Instance.new("UIListLayout")
            list.Padding = UDim.new(0, 8)
            list.SortOrder = Enum.SortOrder.LayoutOrder
            list.Parent = page
            
            local pad = Instance.new("UIPadding")
            pad.PaddingTop = UDim.new(0, 4)
            pad.PaddingLeft = UDim.new(0, 4)
            pad.PaddingRight = UDim.new(0, 6) 
            pad.PaddingBottom = UDim.new(0, 12) 
            pad.Parent = page

            list:GetPropertyChangedSignal("AbsoluteContentSize"):Connect(function()
                page.CanvasSize = UDim2.new(0, 0, 0, list.AbsoluteContentSize.Y + pad.PaddingTop.Offset + pad.PaddingBottom.Offset)
            end)

            local tabBtn = Instance.new("TextButton")
            tabBtn.Size = UDim2.new(1, -12, 0, 32)
            tabBtn.Text = tabName
            tabBtn.TextColor3 = Color3.fromRGB(140, 140, 150)
            tabBtn.Font = Enum.Font.GothamBold
            tabBtn.TextSize = 12
            tabBtn.Parent = TabScrollContainer
            applyCorner(tabBtn, 5)
            applyThemeElement(tabBtn, "BackgroundColor3", "Background")
            
            local indentPad = Instance.new("UIPadding")
            indentPad.PaddingLeft = UDim.new(0, 12) -- Indents the text slightly so it looks grouped
            indentPad.Parent = tabBtn

            tabBtn.MouseButton1Click:Connect(function()
                SearchBox.Text = "" 
                for _, p in pairs(pages) do p.Visible = false end
                for _, t in pairs(tabs) do 
                    t.TextColor3 = Color3.fromRGB(140, 140, 150) 
                    applyThemeElement(t, "BackgroundColor3", "Background")
                end
                page.Visible = true
                currentActivePage = page
                tabBtn.TextColor3 = Color3.fromRGB(245, 245, 250)
                applyThemeElement(tabBtn, "BackgroundColor3", "Accent")
            end)

            table.insert(pages, page)
            table.insert(tabs, tabBtn)
            table.insert(childTabs, tabBtn)
            
            if #pages == 1 then
                page.Visible = true
                currentActivePage = page
                tabBtn.TextColor3 = Color3.fromRGB(245, 245, 250)
                applyThemeElement(tabBtn, "BackgroundColor3", "Accent")
            end
            
            return page, tabBtn
        end
    }
end

