function Components:AddToggle(parent, tabBtn, text, defaultState, callback)
    local basePage = parent:IsA("ScrollingFrame") and parent or parent:FindFirstAncestorWhichIsA("ScrollingFrame")
    local sectionFrame = parent.Name:match("^Section_") and parent.Parent or nil
    
    local stateKey = basePage.Name .. "_" .. text
    if G_State.SavedStates[stateKey] == nil then G_State.SavedStates[stateKey] = defaultState end
    local toggleActive = G_State.SavedStates[stateKey]
    
    local frame = Instance.new("Frame")
    frame.Size = UDim2.new(1, -10, 0, 42)
    frame.Parent = parent
    applyCorner(frame, 6)
    applyThemeElement(frame, "BackgroundColor3", "Secondary")
    
    local label = Instance.new("TextLabel")
    label.Size = UDim2.new(0.7, 0, 1, 0)
    label.Position = UDim2.new(0, 12, 0, 0)
    label.BackgroundTransparency = 1
    label.Text = text
    label.TextColor3 = Color3.fromRGB(245, 245, 250)
    label.Font = Enum.Font.Gotham
    label.TextSize = 13
    label.TextXAlignment = Enum.TextXAlignment.Left
    label.Parent = frame
    
    local statusIndicator = Instance.new("TextButton")
    statusIndicator.Size = UDim2.new(0, 46, 0, 22)
    statusIndicator.Position = UDim2.new(1, -58, 0.5, -11)
    statusIndicator.Text = ""
    statusIndicator.Parent = frame
    applyCorner(statusIndicator, 11)
    applyThemeElement(statusIndicator, "BackgroundColor3", "Background")
    
    local innerDot = Instance.new("Frame")
    innerDot.Size = UDim2.new(0, 16, 0, 16)
    innerDot.Position = toggleActive and UDim2.new(1, -19, 0.5, -8) or UDim2.new(0, 3, 0.5, -8)
    innerDot.Parent = statusIndicator
    applyCorner(innerDot, 8)
    if toggleActive then innerDot.BackgroundColor3 = CurrentTheme.Accent else innerDot.BackgroundColor3 = Color3.fromRGB(140, 140, 150) end
    
    local function fireToggle(bypass)
        if not bypass then toggleActive = not toggleActive; G_State.SavedStates[stateKey] = toggleActive end
        local targetPos = toggleActive and UDim2.new(1, -19, 0.5, -8) or UDim2.new(0, 3, 0.5, -8)
        TweenService:Create(innerDot, TweenInfo.new(0.18, Enum.EasingStyle.Quad), {Position = targetPos}):Play()
        innerDot.BackgroundColor3 = toggleActive and CurrentTheme.Accent or Color3.fromRGB(140, 140, 150)
        task.spawn(callback, toggleActive)
    end
    
    statusIndicator.MouseButton1Click:Connect(function() fireToggle(false) end)
    if toggleActive then task.spawn(callback, true) end

    table.insert(FeatureRegistry, { Disable = function() toggleActive = false; G_State.SavedStates[stateKey] = false; fireToggle(true) end })
    table.insert(SearchRegistry, {UiInstance = frame, FeatureName = text, ParentPage = basePage, TabButton = tabBtn, SectionFrame = sectionFrame})
end

function Components:AddSlider(parent, tabBtn, text, min, max, default, callback)
    local basePage = parent:IsA("ScrollingFrame") and parent or parent:FindFirstAncestorWhichIsA("ScrollingFrame")
    local sectionFrame = parent.Name:match("^Section_") and parent.Parent or nil
    
    local stateKey = basePage.Name .. "_" .. text
    if G_State.SavedStates[stateKey] == nil then G_State.SavedStates[stateKey] = default end
    local currentVal = G_State.SavedStates[stateKey]

    local frame = Instance.new("Frame")
    frame.Size = UDim2.new(1, -10, 0, 52)
    frame.Parent = parent
    applyCorner(frame, 6)
    applyThemeElement(frame, "BackgroundColor3", "Secondary")
    
    local label = Instance.new("TextLabel")
    label.Size = UDim2.new(0.6, 0, 0, 26)
    label.Position = UDim2.new(0, 12, 0, 2)
    label.BackgroundTransparency = 1
    label.Text = text
    label.TextColor3 = Color3.fromRGB(245, 245, 250)
    label.Font = Enum.Font.Gotham
    label.TextSize = 13
    label.TextXAlignment = Enum.TextXAlignment.Left
    label.Parent = frame
    
    local valLabel = Instance.new("TextLabel")
    valLabel.Size = UDim2.new(0.3, 0, 0, 26)
    valLabel.Position = UDim2.new(1, -112, 0, 2)
    valLabel.BackgroundTransparency = 1
    valLabel.Text = tostring(currentVal)
    valLabel.Font = Enum.Font.GothamBold
    valLabel.TextSize = 13
    valLabel.TextXAlignment = Enum.TextXAlignment.Right
    valLabel.Parent = frame
    applyThemeElement(valLabel, "TextColor3", "AccentGlow")

    local sliderTrack = Instance.new("Frame")
    sliderTrack.Size = UDim2.new(1, -24, 0, 6)
    sliderTrack.Position = UDim2.new(0, 12, 0, 36)
    sliderTrack.Parent = frame
    applyCorner(sliderTrack, 3)
    applyThemeElement(sliderTrack, "BackgroundColor3", "Background")
    
    local sliderFill = Instance.new("Frame")
    sliderFill.Size = UDim2.new((currentVal - min) / (max - min), 0, 1, 0)
    sliderFill.Parent = sliderTrack
    applyCorner(sliderFill, 3)
    applyThemeElement(sliderFill, "BackgroundColor3", "Accent")

    local knob = Instance.new("TextButton")
    knob.Size = UDim2.new(0, 14, 0, 14)
    knob.Position = UDim2.new((currentVal - min) / (max - min), -7, 0.5, -7)
    knob.BackgroundColor3 = Color3.fromRGB(255, 255, 255)
    knob.Text = ""
    knob.Parent = sliderTrack
    applyCorner(knob, 7)

    local trackingActive = false
    local function trackInput(input)
        local relativeX = input.Position.X - sliderTrack.AbsolutePosition.X
        local pct = math.clamp(relativeX / sliderTrack.AbsoluteSize.X, 0, 1)
        knob.Position = UDim2.new(pct, -7, 0.5, -7)
        sliderFill.Size = UDim2.new(pct, 0, 1, 0)
        local preciseValue = math.floor(min + (max - min) * pct)
        valLabel.Text = tostring(preciseValue)
        G_State.SavedStates[stateKey] = preciseValue
        task.spawn(callback, preciseValue)
    end

    knob.InputBegan:Connect(function(input) if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then trackingActive = true; trackInput(input) end end)
    sliderTrack.InputBegan:Connect(function(input) if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then trackingActive = true; trackInput(input) end end)
    UserInputService.InputEnded:Connect(function(input) if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then trackingActive = false end end)
    UserInputService.InputChanged:Connect(function(input) if trackingActive and (input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch) then trackInput(input) end end)
    
    if currentVal ~= default then task.spawn(callback, currentVal) end
    table.insert(SearchRegistry, {UiInstance = frame, FeatureName = text, ParentPage = basePage, TabButton = tabBtn, SectionFrame = sectionFrame})
end

local function addDropdown(parent, tabBtn, text, items, callback)
    local basePage = parent:IsA("ScrollingFrame") and parent or parent:FindFirstAncestorWhichIsA("ScrollingFrame")
    local sectionFrame = parent.Name:match("^Section_") and parent.Parent or nil

    local stateKey = basePage.Name .. "_" .. text
    if G_State.SavedStates[stateKey] == nil then G_State.SavedStates[stateKey] = items[1] end
    local activeItem = G_State.SavedStates[stateKey]
    local expanded = false
    
    local frame = Instance.new("Frame")
    frame.Size = UDim2.new(1, -10, 0, 40)
    frame.ClipsDescendants = true
    frame.Parent = parent
    applyCorner(frame, 6)
    applyThemeElement(frame, "BackgroundColor3", "Secondary")
    
    local trigger = Instance.new("TextButton")
    trigger.Size = UDim2.new(1, 0, 0, 40)
    trigger.BackgroundTransparency = 1
    trigger.Text = text .. " : " .. activeItem
    trigger.TextColor3 = Color3.fromRGB(245, 245, 250)
    trigger.Font = Enum.Font.GothamMedium
    trigger.TextSize = 13
    trigger.TextXAlignment = Enum.TextXAlignment.Left
    trigger.Position = UDim2.new(0, 12, 0, 0)
    trigger.Parent = frame
    
    local arrow = Instance.new("TextLabel")
    arrow.Size = UDim2.new(0, 30, 0, 40)
    arrow.Position = UDim2.new(1, -45, 0, 0)
    arrow.BackgroundTransparency = 1
    arrow.Text = "▼"
    arrow.TextColor3 = Color3.fromRGB(140, 140, 150)
    arrow.TextSize = 12
    arrow.Font = Enum.Font.GothamBold
    arrow.Parent = frame

    local container = Instance.new("Frame")
    container.Size = UDim2.new(1, -24, 0, #items * 32)
    container.Position = UDim2.new(0, 12, 0, 42)
    container.BackgroundTransparency = 1
    container.Parent = frame
    
    for idx, name in ipairs(items) do
        local option = Instance.new("TextButton")
        option.Size = UDim2.new(1, 0, 0, 30)
        option.Position = UDim2.new(0, 0, 0, (idx - 1) * 32)
        option.Text = name
        option.TextColor3 = Color3.fromRGB(180, 180, 190)
        option.Font = Enum.Font.Gotham
        option.TextSize = 12
        option.Parent = container
        applyCorner(option, 4)
        applyThemeElement(option, "BackgroundColor3", "Background")
        
        option.MouseButton1Click:Connect(function()
            expanded = false
            frame.Size = UDim2.new(1, -10, 0, 40)
            trigger.Text = text .. " : " .. name
            arrow.Text = "▼"
            G_State.SavedStates[stateKey] = name
            task.spawn(callback, name)
        end)
    end
    
    trigger.MouseButton1Click:Connect(function()
        expanded = not expanded
        frame.Size = expanded and UDim2.new(1, -10, 0, 45 + (#items * 32)) or UDim2.new(1, -10, 0, 40)
        arrow.Text = expanded and "▲" or "▼"
    end)
    
    if activeItem ~= items[1] then task.spawn(callback, activeItem) end
    table.insert(SearchRegistry, {UiInstance = frame, FeatureName = text, ParentPage = basePage, TabButton = tabBtn, SectionFrame = sectionFrame})
end

