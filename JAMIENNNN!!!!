    if scalingActive and (input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch) then
        local delta = input.Position - scaleInputStart
        local targetWidth = math.clamp(initialSize.X + delta.X, 420, 900)
        local targetHeight = math.clamp(initialSize.Y + delta.Y, 280, 650)
        MainFrame.Size = UDim2.new(0, targetWidth, 0, targetHeight)
    end
end)

